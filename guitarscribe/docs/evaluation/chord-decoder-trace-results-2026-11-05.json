  "observation_patch": "--- a/Chordino.cpp\n+++ b/Chordino.cpp\n@@ -26,6 +26,8 @@\n #include <cmath>\n \n #include <algorithm>\n+#include <iomanip>\n+#include <stdexcept>\n \n const bool debug_on = false;\n \n@@ -367,6 +369,7 @@\n \n \t    \n     vector<vector<double> > chordogram;\n+    vector<vector<double> > traceSaliences;\n     vector<vector<int> > scoreChordogram;\n     vector<float> chordchange = vector<float>(tunedSpec.size(),0);\n     count = 0;\n@@ -488,6 +491,7 @@\n \n         // local chord estimation\n         vector<double> currentChordSalience;\n+        vector<double> traceCurrent;\n         double tempchordvalue = 0;\n         double sumchordvalue = 0;\n \t        \n@@ -508,6 +512,7 @@\n                 }\n                 tempchordvalue = 200.0;\n             }\n+            traceCurrent.push_back(tempchordvalue);\n             tempchordvalue = pow(1.3, tempchordvalue);\n             sumchordvalue += tempchordvalue;\n             currentChordSalience.push_back(tempchordvalue);\n@@ -520,6 +525,7 @@\n             currentChordSalience[nChord-1] = 1.0;\n         }\n         chordogram.push_back(currentChordSalience);\n+        traceSaliences.push_back(traceCurrent);\n \t        \n         count++;\n     }\n@@ -545,6 +551,37 @@\n     }\n     vector<double> scale;\n     vector<int> chordpath = ViterbiPath(init, trans, chordogram, delta, &scale);\n+\n+    const char* tracePath = std::getenv(\"GUITARSCRIBE_TRACE_PATH\");\n+    if (tracePath) {\n+        std::ofstream trace(tracePath);\n+        trace << std::setprecision(17);\n+        trace << \"{\\\"dictionary\\\":[\";\n+        for (int c=0;c<nChord;++c) {\n+            if(c) trace << \",\";\n+            trace << \"{\\\"index\\\":\" << c << \",\\\"label\\\":\" << std::quoted(m_chordnames[c]) << \",\\\"weights\\\":[\";\n+            for(int k=0;k<24;++k) {if(k)trace<<\",\";trace<<m_chorddict[c*24+k];}\n+            trace << \"]}\";\n+        }\n+        trace << \"],\\\"frames\\\":[\";\n+        for (int f=0;f<nFrame;++f) {\n+            if(f)trace<<\",\";\n+            const auto& emission=chordogram[f];\n+            int best=std::max_element(emission.begin(),emission.end())-emission.begin();\n+            trace<<\"{\\\"sec\\\":\"<<timestamps[f].sec<<\",\\\"nsec\\\":\"<<timestamps[f].nsec<<\",\\\"local\\\":\"<<best<<\",\\\"hmm\\\":\"<<chordpath[f]<<\",\\\"ties\\\":[\";\n+            bool first=true;\n+            for(int c=0;c<nChord;++c)if(emission[c]==emission[best]){if(!first)trace<<\",\";trace<<c;first=false;}\n+            trace<<\"],\\\"salience\\\":[\";\n+            for(int c=0;c<nChord;++c){if(c)trace<<\",\";trace<<traceSaliences[f][c];}\n+            trace<<\"],\\\"emission\\\":[\";\n+            for(int c=0;c<nChord;++c){if(c)trace<<\",\";trace<<emission[c];}\n+            trace<<\"]}\";\n+        }\n+        trace<<\"]}\\n\";\n+        trace.close();\n+        if(!trace) throw std::runtime_error(\"Trace write failed\");\n+    }\n+\n     \n     Feature chord_feature; // chord estimate\n     chord_feature.hasTimestamp = true;\n"
}
