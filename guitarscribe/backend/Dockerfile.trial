# Trial build uses the same chord/timing engines as the accepted local workflow.
FROM node:22-bookworm-slim AS javascript
FROM python:3.11-slim-bookworm
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libfftw3-dev build-essential curl ca-certificates \
    vamp-plugin-sdk libboost-dev && rm -rf /var/lib/apt/lists/*
ARG CHORDINO_REVISION=4c5f214a75cb354f8d8c933e161377c5b4d83713
RUN mkdir /tmp/chordino /usr/local/lib/vamp && \
    curl -fL --retry 3 "https://github.com/c4dm/nnls-chroma/archive/${CHORDINO_REVISION}.tar.gz" \
      | tar xz --strip-components=1 -C /tmp/chordino && \
    make -C /tmp/chordino -f Makefile.linux -j2 VAMP_SDK_DIR=/usr/include BOOST_ROOT=/usr/include && \
    cp /tmp/chordino/nnls-chroma.so /usr/local/lib/vamp/ && \
    mkdir -p /usr/local/share/licenses/nnls-chroma && \
    cp /tmp/chordino/COPYING /usr/local/share/licenses/nnls-chroma/ && rm -rf /tmp/chordino
ENV VAMP_PATH=/usr/local/lib/vamp OMP_NUM_THREADS=2 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
# CPU versions verified by the local analysis baseline; no melody/separation stack.
RUN pip install --no-cache-dir 'torch==2.5.1' 'torchaudio==2.5.1' --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir 'numpy<2' wheel setuptools && \
    pip install --no-cache-dir --no-build-isolation 'vamp==1.1.0' && \
    python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb')); print('\n'.join(p['project']['dependencies']+p['project']['optional-dependencies']['timing']+p['project']['optional-dependencies']['youtube']))" > /tmp/runtime-requirements.txt && \
    pip install --no-cache-dir -r /tmp/runtime-requirements.txt && rm /tmp/runtime-requirements.txt
# Match the accepted fixed DBN recovery. Only the decoder code is used; do not
# download madmom's separate detection weights. Application edits keep this cache.
ARG MADMOM_REVISION=27f032e8947204902c675e5e341a3faf5dc86dae
ARG MADMOM_MODELS_REVISION=7e3dc1b0cad499792767074d03c38b194b9b0a79
RUN pip install --no-cache-dir 'Cython==0.29.37' 'mido==1.3.3' 'scipy>=1.13,<2' && \
    mkdir /tmp/madmom && \
    curl -fL --retry 3 "https://github.com/CPJKU/madmom/archive/${MADMOM_REVISION}.tar.gz" \
      | tar xz --strip-components=1 -C /tmp/madmom && \
    mkdir -p /tmp/madmom/madmom/models && \
    curl -fL --retry 3 "https://raw.githubusercontent.com/CPJKU/madmom_models/${MADMOM_MODELS_REVISION}/__init__.py" \
      -o /tmp/madmom/madmom/models/__init__.py && \
    curl -fL --retry 3 "https://raw.githubusercontent.com/CPJKU/madmom_models/${MADMOM_MODELS_REVISION}/LICENSE" \
      -o /tmp/madmom/madmom/models/LICENSE && \
    curl -fL --retry 3 "https://raw.githubusercontent.com/CPJKU/madmom_models/${MADMOM_MODELS_REVISION}/README.rst" \
      -o /tmp/madmom/madmom/models/README.rst && \
    pip install --no-cache-dir --no-deps --no-build-isolation /tmp/madmom && \
    mkdir -p /usr/local/share/licenses/madmom /usr/local/share/licenses/madmom-models && \
    cp /tmp/madmom/LICENSE /usr/local/share/licenses/madmom/ && \
    cp /tmp/madmom/madmom/models/LICENSE /tmp/madmom/madmom/models/README.rst /usr/local/share/licenses/madmom-models/ && \
    rm -rf /tmp/madmom
RUN python -c "from beat_this.model.postprocessor import Postprocessor; Postprocessor('dbn')"
RUN python -c "import vamp; assert 'nnls-chroma:chordino' in vamp.list_plugins()"
COPY app ./app
COPY examples ./examples
COPY scripts ./scripts
RUN pip install --no-cache-dir --no-deps -e .
RUN printf '%s\n' '#!/bin/sh' 'exec python -m yt_dlp --js-runtimes node "$@"' > /usr/local/bin/guitarscribe-ytdlp && chmod +x /usr/local/bin/guitarscribe-ytdlp
CMD ["python", "-m", "uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]
