{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "song", "analysis", "key_context", "beats", "chords", "melody", "rhythm", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "song": {
      "type": "object",
      "required": ["title", "source_type", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "source_type": { "type": "string" },
        "source_url": { "type": "string" },
        "duration_seconds": { "type": "number" }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["key", "mode", "bpm", "time_signature", "capo", "confidence", "warnings"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "mode": { "type": "string" },
        "bpm": { "type": "number" },
        "time_signature": { "type": "string" },
        "capo": { "type": "integer" },
        "confidence": { "type": "number" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "key_context": {
      "type": "object",
      "required": ["source", "target", "shape", "sounding", "transpose_semitones", "accidental_preference", "audio_matches_notation"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/definitions/key_signature" },
        "target": { "$ref": "#/definitions/key_signature" },
        "shape": { "$ref": "#/definitions/key_signature" },
        "sounding": { "$ref": "#/definitions/key_signature" },
        "transpose_semitones": { "type": "integer" },
        "accidental_preference": { "type": "string", "enum": ["auto", "sharps", "flats"] },
        "audio_matches_notation": { "type": "boolean" }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "beat", "measure", "confidence"],
        "additionalProperties": false,
        "properties": {
          "time": { "type": "number" },
          "beat": { "type": "integer" },
          "measure": { "type": "integer" },
          "confidence": { "type": "number" }
        }
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "symbol", "confidence", "origin", "edited"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "symbol": { "type": "string" },
          "source_symbol": { "type": ["string", "null"] },
          "shape_symbol": { "type": ["string", "null"] },
          "confidence": { "type": "number" },
          "origin": { "type": "string", "enum": ["model", "user"] },
          "edited": { "type": "boolean" },
          "voicing_id": { "type": ["string", "null"] },
          "available_voicings": {
            "type": "array",
            "items": { "$ref": "#/definitions/chord_voicing" }
          }
        }
      }
    },
    "melody": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "midi", "note", "confidence", "string", "fret", "origin", "edited"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "midi": { "type": "integer" },
          "note": { "type": "string" },
          "source_midi": { "type": ["integer", "null"] },
          "source_note": { "type": ["string", "null"] },
          "confidence": { "type": "number" },
          "string": { "type": ["integer", "null"] },
          "fret": { "type": ["integer", "null"] },
          "origin": { "type": "string", "enum": ["model", "user"] },
          "edited": { "type": "boolean" }
        }
      }
    },
    "rhythm": {
      "type": "object",
      "required": ["subdivision", "pattern_id", "display", "confidence", "label"],
      "additionalProperties": false,
      "properties": {
        "subdivision": { "type": "integer" },
        "pattern_id": { "type": "string" },
        "display": {
          "type": "array",
          "items": { "type": ["string", "null"] }
        },
        "confidence": { "type": "number" },
        "label": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["beat_engine", "chord_engine", "melody_engine"],
      "additionalProperties": false,
      "properties": {
        "beat_engine": { "type": "string" },
        "chord_engine": { "type": "string" },
        "melody_engine": { "type": "string" }
      }
    }
  },
  "definitions": {
    "key_signature": {
      "type": "object",
      "required": ["key", "mode"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "chord_voicing": {
      "type": "object",
      "required": ["id", "symbol", "shape_symbol", "frets", "fingers", "base_fret", "capo", "difficulty", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "shape_symbol": { "type": "string" },
        "frets": {
          "type": "array",
          "items": { "type": ["integer", "null"] }
        },
        "fingers": {
          "type": "array",
          "items": { "type": ["integer", "null"] }
        },
        "base_fret": { "type": "integer" },
        "capo": { "type": "integer" },
        "difficulty": { "type": "number" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
