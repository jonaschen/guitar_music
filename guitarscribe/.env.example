# GuitarScribe Configuration
GUITARSCRIBE_MAX_DURATION_SECONDS=600
GUITARSCRIBE_MAX_CONCURRENT_JOBS=1
# Number allowed to wait in memory in addition to the running job(s).
GUITARSCRIBE_MAX_QUEUED_JOBS=3
GUITARSCRIBE_WORK_DIR=/tmp/guitarscribe
GUITARSCRIBE_CHORD_ENGINE=auto
# Chord decoder calibration defaults; change only for recorded comparison runs.
GUITARSCRIBE_CHORD_CHANGE_THRESHOLD=0.12
GUITARSCRIBE_CHORD_NO_CHORD_THRESHOLD=0.18
GUITARSCRIBE_CHORD_BASE_CHANGE_PENALTY=0.04
GUITARSCRIBE_CHORD_SHORT_EVENT_CHANGE_PENALTY=0.05
GUITARSCRIBE_CHORD_CIRCLE_FIFTHS_BONUS=0.015
GUITARSCRIBE_CHORD_TONAL_PRIOR_SCALE=1.0
GUITARSCRIBE_MELODY_ENGINE=basic_pitch
# Optional: build CPU Demucs support, then enable it at runtime
GUITARSCRIBE_INSTALL_SEPARATION=false
GUITARSCRIBE_MELODY_SEPARATOR=off
GUITARSCRIBE_INSTALL_YOUTUBE=false
GUITARSCRIBE_YOUTUBE_ENABLED=false
# Expensive analysis submissions per client per time window (0 disables this in-memory guard)
GUITARSCRIBE_SUBMISSION_RATE_LIMIT=5
GUITARSCRIBE_SUBMISSION_RATE_WINDOW_SECONDS=3600
# GUITARSCRIBE_DEMUCS_BINARY=demucs
# Log level: DEBUG, INFO, WARNING, ERROR
GUITARSCRIBE_LOG_LEVEL=INFO
