# GuitarScribe Configuration
GUITARSCRIBE_MAX_DURATION_SECONDS=600
GUITARSCRIBE_WORK_DIR=/tmp/guitarscribe
GUITARSCRIBE_CHORD_ENGINE=auto
GUITARSCRIBE_MELODY_ENGINE=basic_pitch
# Optional: build CPU Demucs support, then enable it at runtime
GUITARSCRIBE_INSTALL_SEPARATION=false
GUITARSCRIBE_MELODY_SEPARATOR=off
# GUITARSCRIBE_DEMUCS_BINARY=demucs
# Log level: DEBUG, INFO, WARNING, ERROR
GUITARSCRIBE_LOG_LEVEL=INFO
